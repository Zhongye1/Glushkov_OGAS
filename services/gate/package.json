  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.45.0",
    "@ogas/shared": "workspace:*",
    "hono": "^4.6.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/ws": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  }
}