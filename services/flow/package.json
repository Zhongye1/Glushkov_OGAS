{
  "name": "@ogas/flow",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "oxlint src",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "depcruise": "depcruise src --config ../../.dependency-cruiser.cjs"
  },
  "dependencies": {
    "@ogas/shared": "workspace:*",
    "graphology": "^0.25.4",
    "hono": "^4.6.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  }
}