{
  "name": "@ogas/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"vite --config vite.config.ts\" \"electron .\"",
    "build": "vite build --config vite.config.ts",
    "start": "electron .",
    "lint": "oxlint electron preload renderer/src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "depcruise": "depcruise renderer/src --config ../../.dependency-cruiser.cjs"
  },
  "dependencies": {
    "@ogas/platform": "workspace:*",
    "@ogas/shared": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "electron": "^33.0.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.0"
  }
}